DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/kitchen?schema=public"
AUTH_SECRET="замените-на-случайную-строку"
# В production обязателен канонический URL приложения (без завершающего /)
AUTH_URL="http://localhost:3000"
# Только за доверенным прокси, если Host нельзя вывести из AUTH_URL
# AUTH_TRUST_HOST="true"
# Доверять x-forwarded-for / x-real-ip только за прокси, который их перезаписывает.
# Без этого IP-rate-limit не используется (только per-email).
# В production за прокси рекомендуется TRUST_PROXY=true.
# Не путать с AUTH_TRUST_HOST — на чтение IP не влияет.
# TRUST_PROXY="true"
# В production Upstash обязателен (общий атомарный rate-limit между инстансами).
# Для одного процесса можно явно разрешить in-memory: ALLOW_IN_MEMORY_RATE_LIMIT=true
# UPSTASH_REDIS_REST_URL="https://xxxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="..."
# ALLOW_IN_MEMORY_RATE_LIMIT="true"
