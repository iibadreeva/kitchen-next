generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String  @id @default(uuid())
  email     String  @unique
  password  String

  createAt  DateTime  @default(now()) @map("create_at")
  updateAt  DateTime  @default(now()) @map("update_at")

  @@map("users")
}
